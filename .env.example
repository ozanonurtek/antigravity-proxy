BASE_URL=https://agyproxy.mongodb.help
CONFIG_FILE=/app/data/config.json
ACCOUNTS_FILE=/app/data/antigravity-accounts.json
API_KEY=your_api_key_here
WEB_PASSWORD=your_web_password_here
OPENCODE_API_KEY=your_opencode_zen_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
SAFETY_THRESHOLD=BLOCK_NONE

# Optional: pull the published multi-arch image instead of building locally.
# AGY_IMAGE=ghcr.io/ozanonurtek/antigravity-proxy:latest
