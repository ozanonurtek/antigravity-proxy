BASE_URL=http://localhost:3000
SAFETY_THRESHOLD=BLOCK_NONE

# Security Settings (Optional)
# Set API_KEY or API_KEYS to protect OpenAI API endpoints (/v1/*)
# Clients must pass Authorization: Bearer <API_KEY> or x-api-key: <API_KEY>
API_KEY=your_api_key_here

# Set WEB_PASSWORD or DASHBOARD_PASSWORD to protect the Web Dashboard console & management API
WEB_PASSWORD=your_web_password_here
